{
  "expo": {
    "name": "Splitz",
    "slug": "splitz-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "splitz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/logo.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "android": {
      "package": "com.roziannn.splitz",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#0f766e"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-mlkit-unbundled.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Splitz memerlukan kamera untuk memindai struk belanja.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bf2dfff-15d1-4187-98c2-4505760a4b2d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9bf2dfff-15d1-4187-98c2-4505760a4b2d",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "NEVER"
    },
    "icon": "./assets/brand/icon.png",
    "web": {
      "favicon": "./assets/brand/favicon.png"
    }
  }
}
